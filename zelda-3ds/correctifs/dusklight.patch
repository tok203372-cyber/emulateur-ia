+
+    borealis::log::shutdown();
+    fflush(stdout);
+    fflush(stderr);
+
+    mDoMch_Destroy();
+    OSResetSystem(OS_RESET_SHUTDOWN, 0, 0);
+
+    dusk::audio::Shutdown();
+    dusk::config::shutdown();
+    aurora_shutdown();
+    return 0;
+}
