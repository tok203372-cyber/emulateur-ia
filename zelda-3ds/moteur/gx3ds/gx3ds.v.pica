; Shader de sommets du moteur GX -> PICA200 (New 3DS).
;
; Reproduit la partie « transformation et éclairage » (XF) de la GameCube :
;  - position transformée par une des 10 matrices de position (indice par sommet),
;  - éclairage par sommet (couleur ambiante + jusqu'à 4 lumières, diffus « clamp »),
;  - 3 coordonnées de texture calculées par des matrices de texture.
;
; Entrées (préparées par le processeur) :
;   v0 position (x, y, z) en espace objet
;   v1 normale (x, y, z)
;   v2 couleur 0 (octets 0..255)
;   v3, v4, v5 sources des coordonnées de texture (s, t, 1) ou (x, y, z)
;   v6 indice de la matrice de position (0, 3, 6 ... 27)

.fvec projection[4]
.fvec posmtx[30]
.fvec texmtx[9]
.fvec matcol, ambcol
.fvec lumieres[20]

.constf cst(0.0, 1.0, 0.00392156862745, 0.5)
.alias zero cst.xxxx
.alias un cst.yyyy
.alias inv255 cst.zzzz

; (nombre de lumières - 1, départ, pas de 5 registres par lumière, 0)
.ivec boucle

.bool eclairage
.bool matvtx
.bool ambvtx
.bool alphavtx
.bool attenuation
.bool proj0
.bool proj1
.bool proj2
.bool avecLumieres

.in inpos v0
.in innrm v1
.in inclr v2
.in intc0 v3
.in intc1 v4
.in intc2 v5
.in inmtx v6

.out outpos position
.out outclr color
.out outtc0 texcoord0
.out outtc1 texcoord1
.out outtc2 texcoord2

.proc main
	; --- Position : la matrice est choisie par l'indice du sommet (a0.x)
	mova a0.x, inmtx.x
	mov r0.xyz, inpos
	mov r0.w, un
	dp4 r1.x, posmtx[a0.x], r0
	dp4 r1.y, posmtx[a0.x+1], r0
	dp4 r1.z, posmtx[a0.x+2], r0
	mov r1.w, un
	dp4 outpos.x, projection[0], r1
	dp4 outpos.y, projection[1], r1
	dp4 outpos.z, projection[2], r1
	dp4 outpos.w, projection[3], r1

	; --- Coordonnées de texture
	mov r2.xyz, intc0
	mov r2.w, un
	dp4 r3.x, texmtx[0], r2
	dp4 r3.y, texmtx[1], r2
	dp4 r3.z, texmtx[2], r2
	mov r3.w, un
	ifu proj0
		rcp r3.w, r3.z
		mul r3.xy, r3.wwww, r3.xy
		mov r3.w, un
	.end
	mov outtc0, r3

	mov r2.xyz, intc1
	mov r2.w, un
	dp4 r3.x, texmtx[3], r2
	dp4 r3.y, texmtx[4], r2
	dp4 r3.z, texmtx[5], r2
	mov r3.w, un
	ifu proj1
		rcp r3.w, r3.z
		mul r3.xy, r3.wwww, r3.xy
		mov r3.w, un
	.end
	mov outtc1, r3

	mov r2.xyz, intc2
	mov r2.w, un
	dp4 r3.x, texmtx[6], r2
	dp4 r3.y, texmtx[7], r2
	dp4 r3.z, texmtx[8], r2
	mov r3.w, un
	ifu proj2
		rcp r3.w, r3.z
		mul r3.xy, r3.wwww, r3.xy
		mov r3.w, un
	.end
	mov outtc2, r3

	; --- Couleur du sommet (0..1)
	mul r4, inv255, inclr

	; Couleur du matériau : registre ou sommet
	mov r5, matcol
	ifu matvtx
		mov r5.xyz, r4.xyz
	.end
	ifu alphavtx
		mov r5.w, r4.w
	.end

	ifu eclairage
		; Couleur ambiante : registre ou sommet
		mov r6, ambcol
		ifu ambvtx
			mov r6, r4
		.end

		ifu avecLumieres
			; Normale en espace vue (partie 3x3 de la matrice de position), normalisée
			dp3 r7.x, posmtx[a0.x], innrm
			dp3 r7.y, posmtx[a0.x+1], innrm
			dp3 r7.z, posmtx[a0.x+2], innrm
			dp3 r8.x, r7, r7
			rsq r8.x, r8.x
			mul r7.xyz, r8.xxxx, r7.xyz

			for boucle
				; L = position de la lumière - position du sommet
				add r9.xyz, lumieres[aL], -r1
				dp3 r10.x, r9, r9
				rsq r10.y, r10.x
				mul r9.xyz, r10.yyyy, r9.xyz
				; diffus : max(0, N.L)
				dp3 r11.x, r9, r7
				max r11.x, zero, r11.x
				ifu attenuation
					; angle : a0 + a1 cos + a2 cos²   (cos = max(0, L.dir))
					dp3 r12.x, lumieres[aL+1], r9
					max r12.x, zero, r12.x
					mov r13.x, un
					mov r13.y, r12.x
					mul r13.z, r12.x, r12.x
					dp3 r12.y, lumieres[aL+3], r13
					max r12.y, zero, r12.y
					; distance : k0 + k1 d + k2 d²
					rcp r13.y, r10.y
					mov r13.x, un
					mov r13.z, r10.x
					dp3 r12.z, lumieres[aL+4], r13
					rcp r12.z, r12.z
					mul r12.y, r12.y, r12.z
					mul r11.x, r11.x, r12.y
				.end
				mad r6, r11.xxxx, lumieres[aL+2], r6
			.end
		.end

		max r6, zero, r6
		min r6, un, r6
		mul r5.xyz, r6.xyz, r5.xyz
	.end

	mov outclr, r5
	end
.end
