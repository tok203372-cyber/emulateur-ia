; Shader de test : position (v0), couleur en octets (v1), coordonnées de texture (v2)

.fvec projection[4]

; 1/255 : les octets de couleur arrivent entre 0 et 255
.constf constantes(0.0, 1.0, 0.00392156862, 0.5)
.alias  uns constantes.yyyy
.alias  inv255 constantes.zzzz

.out outpos position
.out outclr color
.out outtc0 texcoord0

.alias inpos v0
.alias inclr v1
.alias intc0 v2

.proc main
	mov r0.xyz, inpos
	mov r0.w,   uns

	dp4 outpos.x, projection[0], r0
	dp4 outpos.y, projection[1], r0
	dp4 outpos.z, projection[2], r0
	dp4 outpos.w, projection[3], r0

	mul outclr, inv255, inclr
	mov outtc0, intc0
	end
.end
